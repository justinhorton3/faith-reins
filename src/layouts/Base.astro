---
import "../styles/global.css";
import { iconCss } from "../lib/lib.mjs";
const { title, description, route = "/" } = Astro.props;
const SITE = "https://faithreins.org";
const canonical = SITE + (route === "/" ? "" : route);
const ogImage = SITE + "/assets/hero-home-desktop.webp";
// Strip " | Faith Reins" suffix for og:title
const ogTitle = title.replace(/ \| Faith Reins$/, "");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Faith Reins" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:alt" content="Faith Reins Equestrian Center in Camden, Arkansas" />
    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/logo.png" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;700&family=Noto+Serif:wght@600&display=swap" />
    <Fragment set:html={`<style>${iconCss()}</style>`} />
  </head>
  <body>
    <div id="shell-header"><noscript><a href="/">Home</a> <a href="/services-programs">Services</a> <a href="/book-online">Book</a> <a href="/give">Give</a> <a href="/contact">Contact</a></noscript></div>
    <main id="main"><slot /></main>
    <div id="shell-footer"></div>
    <script>import "../scripts/site.js";</script>
  </body>
</html>
