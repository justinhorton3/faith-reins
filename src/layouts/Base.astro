---
import "../styles/global.css";
import { iconCss } from "../lib/lib.mjs";
const { title, description, route = "/", jsonld } = Astro.props;
const SITE = "https://faithreins.org";
const canonical = SITE + (route === "/" ? "" : route);
const ogImage = SITE + "/assets/hero-home-desktop.webp";
const ogTitle = title.replace(/ \| Faith Reins$/, "");

const orgSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "MedicalBusiness"],
  "@id": SITE + "/#organization",
  "name": "Faith Reins Equestrian Center",
  "description": "Faith-based pediatric therapy and equine-assisted learning center serving children and families in South Arkansas.",
  "url": SITE,
  "telephone": "+18708184087",
  "email": "info@faithreins.com",
  "logo": SITE + "/assets/logo.png",
  "image": ogImage,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "226 Ouachita County Rd 45",
    "addressLocality": "Camden",
    "addressRegion": "AR",
    "postalCode": "72711",
    "addressCountry": "US"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 33.5843, "longitude": -92.8343 },
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "08:00", "closes": "17:00" }
  ],
  "priceRange": "$$",
  "currenciesAccepted": "USD",
  "paymentAccepted": "Credit Card, Insurance",
  "nonprofitStatus": "Nonprofit501c3",
  "medicalSpecialty": ["Pediatrics","PhysicalTherapy","SpeechTherapy","OccupationalTherapy"],
  "areaServed": { "@type": "State", "name": "Arkansas" }
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Faith Reins" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:alt" content="Faith Reins Equestrian Center in Camden, Arkansas" />
    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Analytics: replace GA_MEASUREMENT_ID with your GA4 ID (G-XXXXXXXXXX) -->
    <!-- To use Wix Analytics instead, remove the GA block and paste your Wix Analytics embed here -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=GA_MEASUREMENT_ID"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'GA_MEASUREMENT_ID', { page_path: window.location.pathname });
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/logo.png" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;700&family=Noto+Serif:wght@600&display=swap" />
    <Fragment set:html={`<style>${iconCss()}</style>`} />
  </head>
  <body>
    <div id="shell-header"><noscript><a href="/">Home</a> <a href="/services-programs">Services</a> <a href="/book-online">Book</a> <a href="/give">Give</a> <a href="/contact">Contact</a></noscript></div>
    <main id="main"><slot /></main>
    <div id="shell-footer"></div>
    <script>import "../scripts/site.js";</script>
    <script>import "../scripts/cart.js";</script>
  </body>
</html>
