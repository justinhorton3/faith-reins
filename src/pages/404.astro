---
import Base from "../layouts/Base.astro";
export const prerender = true;
---
<Base title="Page Not Found | Faith Reins" description="The page you were looking for doesn't exist. Let us help you find what you need." route="/404">
  <section class="sec">
    <div class="sec__in">
      <div class="thanks">
        <span class="eyebrow">Page not found</span>
        <h1>We can't find that page.</h1>
        <p class="lead">It may have moved or the link might be wrong. Here are a few places to start.</p>
        <div class="btn-row" style="justify-content:center">
          <a class="btn" href="/book-online">Request an appointment</a>
          <a class="tlink" href="/">Home</a>
          <a class="tlink" href="/services-programs">Therapies</a>
          <a class="tlink" href="/faq">FAQ</a>
          <a class="tlink" href="/contact">Contact</a>
        </div>
      </div>
    </div>
  </section>
</Base>
