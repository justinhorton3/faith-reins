---
import Base from "../layouts/Base.astro";
---
<Base title="Page Not Found | Faith Reins" description="The page you were looking for doesn't exist. Let us help you find what you need." route="/404">
  <section class="section" style="min-height:60vh;display:flex;align-items:center">
    <div class="container" style="text-align:center">
      <p style="font-family:var(--serif);font-size:6rem;font-weight:600;color:#e0dbd4;line-height:1;margin:0">404</p>
      <h1 style="margin-top:1rem">We can't find that page.</h1>
      <p class="lead muted" style="max-width:480px;margin:1rem auto 2rem">It may have moved or the link might be wrong. Here are a few places to start:</p>
      <div style="display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center">
        <a class="btn" href="/">Home</a>
        <a class="btn btn--secondary" href="/services-programs">Services</a>
        <a class="btn btn--secondary" href="/book-online">Request an appointment</a>
        <a class="btn btn--secondary" href="/faq">FAQ</a>
        <a class="btn btn--secondary" href="/contact">Contact</a>
      </div>
    </div>
  </section>
</Base>
