---
import Base from "../layouts/Base.astro";
import { pages } from "../lib/build.mjs";
export const prerender = true;
export function getStaticPaths() {
  return pages.map((p) => ({ params: { slug: p.route === "/" ? undefined : p.route.slice(1) }, props: p }));
}
const { title, description, body, route, jsonld, seo } = Astro.props;
---
<Base title={title} description={description} body={body} route={route} jsonld={jsonld} seo={seo}><Fragment set:html={body} /></Base>
