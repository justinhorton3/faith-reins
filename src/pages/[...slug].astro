---
import Base from "../layouts/Base.astro";
import { pages } from "../lib/build.mjs";
export function getStaticPaths() {
  return pages.map((p) => ({ params: { slug: p.route === "/" ? undefined : p.route.slice(1) }, props: p }));
}
const { title, description, body } = Astro.props;
---
<Base title={title} description={description}><Fragment set:html={body} /></Base>
